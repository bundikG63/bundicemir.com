Options -Indexes
<FilesMatch "\.(sqlite|sqlite3|db|log|md|example\.php)$">
    Require all denied
</FilesMatch>
<FilesMatch "^(lib|config)\.php$">
    Require all denied
</FilesMatch>
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
